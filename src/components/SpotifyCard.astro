---
const spotifyToken = import.meta.env.SPOTIFY_ACCESS_TOKEN;

type SpotifyTrack = {
  name?: string;
  artists?: Array<{ name?: string }>;
  album?: {
    images?: Array<{ url?: string }>;
  };
};

async function getTopTracks(): Promise<SpotifyTrack[]> {
  if (!spotifyToken) {
    return [];
  }

  const response = await fetch('https://api.spotify.com/v1/me/top/tracks?time_range=long_term&limit=5', {
    headers: {
      Authorization: `Bearer ${spotifyToken}`,
    },
  });

  if (!response.ok) {
    console.error('Spotify API request failed:', response.status, response.statusText);
    return [];
  }

  const data = await response.json();
  return data.items ?? [];
}

const tracks = await getTopTracks();

const visibleTracks = tracks.length
  ? tracks.map((track) => ({
      name: track.name ?? 'Unknown title',
      artist: track.artists?.map((artist) => artist.name).join(', ') ?? 'Unknown artist',
      image: track.album?.images?.[0]?.url ?? '/mex.png',
    }))
  : Array.from({ length: 5 }, (_, index) => ({
      name: `Song ${index + 1}`,
      artist: 'Spotify',
      image: '/mex.png',
    }));
---

<article class="spotify-card">
    <h1>My top 5 tracks on Spotify</h1>
    {visibleTracks.map((song) => (
        <div class="song">
            <h2 class="song-name">{song.name}</h2>
            <p class="song-artist">{song.artist}</p>
            <img class="song-img" src={song.image} alt={song.name} />
        </div>
    ))}
</article>

<style>
    .spotify-card{
        background-color: var(--c-black);
        display: flex;
        flex-direction: column;
        padding: 1rem;
        gap: 1rem;
        border-radius: var(--m-border-radius);
    }
    h1{
        font-size: var(--t-large);
        color: greenyellow;
    }
    .song{
        padding: 10px;
        background-color: green;
        border-radius: var(--m-border-radius);
        display: grid;
        align-items: center;
        grid-template-columns: 1fr min-content;
        grid-template-rows: min-content min-content;
    }
    .song-name{
        grid-column: 1/2;
        grid-row: 1/2;
        font-size: var(--t-big);
    }
    .song-artist{
        grid-column: 1/2;
        grid-row: 2/3;
        font-size: var(--t-medium);
    }
    .song-img{
        grid-column: 2/3;
        grid-row: 1/3;
        width: 60px;
        height: 60px;
        border: 3px solid black;
        border-radius: var(--m-border-radius);
    }
</style>